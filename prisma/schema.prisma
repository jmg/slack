// Slack clone — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  image        String?
  /// Bumped to invalidate every outstanding session for this user (logout,
  /// password change, forced sign-out). The signed JWT carries the value it was
  /// issued at; getCurrentUser rejects the token when they no longer match.
  tokenVersion Int      @default(0)
  /// Email me about messages I haven't seen (see the notify-emails cron).
  emailNotifications Boolean @default(true)
  /// Dedupe cursor for that cron: messages created at/before this have already
  /// been considered for an email, so we never notify the same message twice.
  lastNotifiedAt DateTime?
  /// Sidebar color theme key (see src/lib/themes.ts).
  chatTheme    String   @default("aubergine")
  /// Set when the account is deleted: PII is scrubbed and the user can no longer
  /// authenticate (getCurrentUser rejects them). Messages stay, authored by a
  /// "Deleted user" placeholder, so others' threads survive.
  deactivatedAt DateTime?
  /// Heartbeat from the client; drives the online/offline presence dot.
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces     Workspace[]          @relation("WorkspaceOwner")
  memberships         WorkspaceMember[]
  channelMemberships  ChannelMember[]
  conversationMembers ConversationMember[]
  messages            Message[]
  reactions           Reaction[]
  readStates          ReadState[]
  pushSubscriptions   PushSubscription[]
  attachments         Attachment[]
  createdChannels     Channel[]            @relation("ChannelCreator")
  createdInvites      Invite[]             @relation("InviteCreator")
  stars               Star[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageUrl  String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Billing (Stripe). "free" or "team". The subscription is per workspace,
  /// quantity = seats (member count). See src/lib/billing.ts + the webhook.
  plan                 String    @default("free")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Stripe subscription status (active, trialing, past_due, canceled, …).
  subscriptionStatus   String?
  /// End of the current paid period; the plan stays "team" until then.
  currentPeriodEnd     DateTime?

  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members       WorkspaceMember[]
  channels      Channel[]
  conversations Conversation[]
  attachments   Attachment[]
  invites       Invite[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Channel {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  /// Set when the channel is archived: hidden from posting, kept for history.
  archivedAt  DateTime?
  /// Who created the channel. Nullable so pre-existing rows can be backfilled
  /// and so the reference survives the creator being deleted. A channel with no
  /// creator can only be managed by workspace ADMINs.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members    ChannelMember[]
  messages   Message[]
  readStates ReadState[]
  stars      Star[]

  @@unique([workspaceId, name])
  @@index([createdById])
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

// A direct-message conversation (1:1 or group) inside a workspace.
model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  createdAt   DateTime @default(now())

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members    ConversationMember[]
  messages   Message[]
  readStates ReadState[]
  stars      Star[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  body           String
  userId         String
  channelId      String?
  conversationId String?
  parentId       String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent       Message?      @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Message[]     @relation("Thread")
  reactions    Reaction[]
  attachments  Attachment[]

  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
  @@index([parentId])
  @@index([userId])
}

/// A file stored in object storage (the MinIO add-on in production) and shown
/// on a message. Uploads are created "pending" (messageId null) and claimed by
/// the message that is sent with them.
model Attachment {
  id          String   @id @default(cuid())
  /// Object key in the bucket: "w/<workspaceId>/<uuid><ext>". Kept charset-safe
  /// so the signed URL path never needs percent-encoding (a mismatch between the
  /// encoding used to sign and to request is the classic SigV4 403). The
  /// user-facing name lives in `filename`, never in the key.
  key         String   @unique
  filename    String
  contentType String
  size        Int
  /// Intrinsic pixel size for images (measured client-side, clamped server-side)
  /// so the <img> reserves space and doesn't shift layout. Null for non-images.
  width       Int?
  height      Int?
  /// Null while the upload is pending — the composer holds it before the message
  /// exists. Set when the message is sent, in the same transaction.
  messageId   String?
  /// Always set: authorizes reads of a still-pending upload and scopes the key.
  workspaceId String
  uploaderId  String
  createdAt   DateTime @default(now())

  message   Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId, messageId])
  @@index([createdAt])
}

/// Per-user read cursor for a channel or a DM conversation. Anything created
/// after `lastReadAt` counts as unread.
model ReadState {
  id             String   @id @default(cuid())
  userId         String
  channelId      String?
  conversationId String?
  lastReadAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@unique([userId, conversationId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
}

/// A shareable, expiring invite link to a workspace. Reusable until it expires
/// or is revoked — anyone who opens the link and signs in joins as a MEMBER.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A user's starred (favourited) channel or DM — surfaced in a "Starred" section.
model Star {
  id             String   @id @default(cuid())
  userId         String
  channelId      String?
  conversationId String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@unique([userId, conversationId])
  @@index([userId])
}

/// Append-only audit trail for auth + state-changing/admin actions. Stores ids
/// as plain strings (no FKs) so entries survive the referenced rows being
/// deleted — the whole point of an audit log.
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  actorId     String?
  workspaceId String?
  targetType  String?
  targetId    String?
  meta        String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
}

/// Cache of Open-Graph link previews (unfurls). Keyed by the URL itself. `ok`
/// records a failed/blocked fetch so we don't keep retrying a bad URL.
model LinkPreview {
  url         String   @id
  ok          Boolean  @default(true)
  title       String?
  description String?
  imageUrl    String?
  siteName    String?
  fetchedAt   DateTime @default(now())
}

/// A browser Web Push subscription (one per device/browser) for delivering
/// mention/DM notifications when the app is closed. See src/lib/push.ts.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// WhatsApp clone — the second app in this repo, served at /wpp and on the
// wpp.talkaroo.app subdomain (see src/middleware.ts).
//
// Everything below is prefixed `Wa` and shares *nothing* with the Slack models
// above: a separate identity (phone number, not email), a separate session
// cookie, a separate SSE bus. Same database, same Prisma client — two products.
// ═══════════════════════════════════════════════════════════════════════════

enum WaChatType {
  DIRECT
  GROUP
}

enum WaMemberRole {
  MEMBER
  ADMIN
}

enum WaMessageKind {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE
  DOCUMENT
  SYSTEM
  POLL
}

/// Who may see a piece of profile data. Mirrors WhatsApp's privacy options.
enum WaVisibility {
  EVERYONE
  CONTACTS
  NOBODY
}

enum WaStatusKind {
  TEXT
  IMAGE
  VIDEO
}

enum WaAttachmentPurpose {
  MESSAGE
  AVATAR
  GROUP_ICON
  STATUS
}

/// A WhatsApp account. Identity is the phone number in E.164 form — there is no
/// email anywhere in this half of the app.
model WaUser {
  id           String  @id @default(cuid())
  /// E.164, e.g. "+541123456789". Normalised by lib/wpp/phone.ts before write.
  phone        String  @unique
  name         String
  about        String  @default("Hey there! I am using Talkaroo.")
  passwordHash String
  avatarUrl    String?
  /// Bumped to kill every outstanding session (logout-everywhere, password
  /// change). Same revocation trick as the Slack half — see lib/wpp/auth.ts.
  tokenVersion Int     @default(0)

  /// UI language: "en" | "es". Server-rendered pages read this; the cookie is
  /// only a pre-login fallback (see lib/wpp/i18n.ts).
  locale    String @default("en")
  /// "light" | "dark" | "system".
  theme     String @default("system")
  /// Chat background key (see lib/wpp/wallpapers.ts).
  wallpaper String @default("default")

  /// Heartbeat from the client; drives "online" / "last seen today at …".
  lastSeenAt DateTime?

  // ── Privacy (Settings → Privacy) ────────────────────────────────────────
  lastSeenPrivacy WaVisibility @default(EVERYONE)
  avatarPrivacy   WaVisibility @default(EVERYONE)
  aboutPrivacy    WaVisibility @default(EVERYONE)
  /// Off ⇒ we never expose this user's read cursor *and* never show them
  /// anyone else's blue ticks. Reciprocal, exactly like WhatsApp.
  readReceipts    Boolean      @default(true)

  /// Set on account deletion: PII scrubbed, can never authenticate again.
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships    WaChatMember[]
  messages       WaMessage[]
  reactions      WaReaction[]
  stars          WaMessageStar[]
  hiddenMessages WaMessageHide[]
  attachments    WaAttachment[]
  createdChats   WaChat[]        @relation("WaChatCreator")
  contacts       WaContact[]     @relation("WaContactOwner")
  contactOf      WaContact[]     @relation("WaContactTarget")
  blocksMade     WaBlock[]       @relation("WaBlocker")
  blockedBy      WaBlock[]       @relation("WaBlocked")
  statuses       WaStatus[]
  statusViews    WaStatusView[]
  mentions       WaMention[]
  pollVotes      WaPollVote[]
  pinnedMessages WaMessage[]     @relation("WaMessagePinner")

  @@index([lastSeenAt])
}

/// A 1:1 chat or a group. There is no "workspace" — a chat is the top-level
/// container, exactly like the real thing.
model WaChat {
  id   String     @id @default(cuid())
  type WaChatType

  // Group-only attributes; all null for a DIRECT chat.
  subject     String?
  description String?
  iconUrl     String?

  /// Stable dedupe key for DIRECT chats: the two user ids sorted and joined
  /// with ":". Unique, so two people can never end up with two 1:1 chats even
  /// if both tap "message" at the same instant. Null for groups.
  directKey String? @unique

  createdById String?
  /// Group invite link token ("chat.whatsapp.com/<token>"). Rotatable.
  inviteToken String? @unique

  onlyAdminsCanSend     Boolean @default(false)
  onlyAdminsCanEditInfo Boolean @default(true)

  /// Disappearing messages: how long a *new* message survives, in seconds.
  /// Null = off. Applied at send time to `WaMessage.expiresAt` rather than
  /// evaluated per read, so changing the timer never retroactively deletes
  /// history that was sent under the old setting — which is exactly how
  /// WhatsApp behaves.
  disappearingSeconds Int?

  /// Denormalised sort key for the chat list — kept in step on every send so
  /// listing N chats never needs N message subqueries.
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   WaUser?        @relation("WaChatCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     WaChatMember[]
  messages    WaMessage[]
  attachments WaAttachment[]

  @@index([lastMessageAt])
  @@index([createdById])
}

/// One participant's view of a chat: their role, their read cursor, and all the
/// per-user chat state WhatsApp keeps (pinned / archived / muted / cleared).
model WaChatMember {
  id     String       @id @default(cuid())
  chatId String
  userId String
  role   WaMemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  /// Set when the member leaves or is removed. The row is kept so their old
  /// messages still resolve a sender and the system messages make sense.
  leftAt   DateTime?

  /// Read cursor — anything newer is unread. Also what turns *other people's*
  /// ticks blue, but only when this user has readReceipts on.
  lastReadAt      DateTime  @default(now())
  /// Delivery cursor — advanced whenever this user's client is connected.
  lastDeliveredAt DateTime  @default(now())

  pinnedAt   DateTime?
  archivedAt DateTime?
  /// Muted until this instant; far-future for "always".
  mutedUntil DateTime?
  /// "Clear chat" — hide everything created at or before this instant, for
  /// this user only. Never deletes rows (the other side keeps their history).
  clearedAt  DateTime?
  /// Unsent composer text, restored when the chat is reopened.
  draft      String?

  chat WaChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user WaUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, archivedAt])
}

model WaMessage {
  id       String        @id @default(cuid())
  chatId   String
  /// Null for SYSTEM messages ("Ada created this group").
  senderId String?
  kind     WaMessageKind @default(TEXT)
  body     String        @default("")

  /// Quoted message (WhatsApp "reply"). SetNull so deleting the quoted message
  /// doesn't cascade away every reply to it.
  replyToId String?

  /// 0 = original. 1 = "Forwarded". 4+ renders as "Forwarded many times",
  /// matching WhatsApp's escalation.
  forwardScore Int @default(0)

  /// SYSTEM messages carry a machine-readable action + JSON meta instead of a
  /// body, so the same row renders in English or Spanish per viewer.
  systemAction String?
  systemMeta   String?

  editedAt  DateTime?
  /// "Delete for everyone" — tombstoned, body blanked on serialize, so replies
  /// that quote it still resolve.
  deletedAt DateTime?
  /// Set at send time when the chat has a disappearing timer. Past this instant
  /// the message is filtered out of every read and swept by the cleanup in
  /// lib/wpp/disappearing.ts.
  expiresAt DateTime?
  /// Pinned to the top of the chat, for everyone. WhatsApp allows several pins
  /// per chat, so this is a column on the message rather than one on the chat.
  pinnedAt   DateTime?
  pinnedById String?
  createdAt DateTime  @default(now())

  chat        WaChat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      WaUser?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo     WaMessage?      @relation("WaReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     WaMessage[]     @relation("WaReply")
  pinnedBy    WaUser?         @relation("WaMessagePinner", fields: [pinnedById], references: [id], onDelete: SetNull)
  reactions   WaReaction[]
  attachments WaAttachment[]
  stars       WaMessageStar[]
  hides       WaMessageHide[]
  mentions    WaMention[]
  poll        WaPoll?

  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([expiresAt])
  @@index([chatId, pinnedAt])
  @@index([pinnedById])
}

/// Someone named with `@` in a message.
///
/// Stored rather than re-derived by substring-matching the body: names change,
/// two people in a group can share a first name, and the unread `@` badge has to
/// be a cheap indexed count rather than a scan of every message body.
model WaMention {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message WaMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    WaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

/// A poll. One per message, and the message's `kind` is POLL.
model WaPoll {
  id            String    @id @default(cuid())
  messageId     String    @unique
  question      String
  /// WhatsApp lets the author decide whether voters may pick more than one.
  allowMultiple Boolean   @default(false)
  /// Set when the author stops the poll; votes are frozen but stay visible.
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  message WaMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options WaPollOption[]
}

model WaPollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String
  /// Display order, fixed at creation so the list never reshuffles under a voter.
  position Int

  poll  WaPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes WaPollVote[]

  @@index([pollId, position])
}

model WaPollVote {
  id        String   @id @default(cuid())
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  option WaPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   WaUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId])
}

/// WhatsApp allows exactly one reaction per person per message — hence the
/// unique on (messageId, userId) rather than (messageId, userId, emoji).
model WaReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message WaMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    WaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model WaMessageStar {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message WaMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    WaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

/// "Delete for me": the row survives for everyone else, this user stops seeing
/// it. Distinct from WaMessage.deletedAt ("delete for everyone").
model WaMessageHide {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message WaMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    WaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

/// Media on a message or a status. Same two-phase upload as the Slack half:
/// created pending (messageId null) and claimed inside the send transaction.
model WaAttachment {
  id          String  @id @default(cuid())
  /// Object key: "wa/<chatId|u/userId>/<uuid><ext>". Charset-safe so the signed
  /// URL never needs percent-encoding.
  ///
  /// Deliberately *not* unique: forwarding a photo creates a second row that
  /// points at the same stored object rather than copying tens of megabytes.
  /// `deleteWaAttachment` therefore ref-counts on this column before removing
  /// anything from the bucket.
  key         String
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  /// Audio/video length, for the "0:07" label on a voice note.
  durationMs  Int?
  /// Voice-note waveform: comma-separated 0-100 amplitude samples, drawn as the
  /// bar chart inside the bubble.
  waveform    String?

  /// What this upload is for. Drives authorization in /api/wpp/files/[id]:
  /// message media needs chat membership, a profile photo or group icon is
  /// readable by any signed-in account (its id is unguessable and privacy is
  /// enforced when deciding whether to hand the URL out at all), and status
  /// media follows the status's own visibility.
  purpose    WaAttachmentPurpose @default(MESSAGE)

  /// Null while pending, set when the message is sent (same transaction).
  messageId  String?
  /// Null for profile and status media, which aren't scoped to a chat.
  chatId     String?
  uploaderId String
  createdAt  DateTime @default(now())

  message  WaMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chat     WaChat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  uploader WaUser     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  status   WaStatus?

  @@index([messageId])
  @@index([uploaderId, messageId])
  @@index([chatId])
  @@index([key])
}

/// A saved contact. WhatsApp shows the *saved* name for people in your address
/// book and the raw phone number for everyone else — `alias` is that name.
model WaContact {
  id        String   @id @default(cuid())
  ownerId   String
  contactId String
  alias     String?
  createdAt DateTime @default(now())

  owner   WaUser @relation("WaContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact WaUser @relation("WaContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@index([contactId])
}

/// A blocked contact: they can't message you and can't see your presence.
model WaBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker WaUser @relation("WaBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked WaUser @relation("WaBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A 24-hour "Status" (Estado). Expired rows are filtered on read and swept by
/// the cleanup in lib/wpp/status.ts — never shown past `expiresAt`.
model WaStatus {
  id              String       @id @default(cuid())
  userId          String
  kind            WaStatusKind @default(TEXT)
  body            String       @default("")
  /// Background for a TEXT status (one of the WhatsApp palette keys).
  backgroundColor String?
  attachmentId    String?      @unique
  createdAt       DateTime     @default(now())
  expiresAt       DateTime

  user       WaUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment WaAttachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  views      WaStatusView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model WaStatusView {
  id       String   @id @default(cuid())
  statusId String
  viewerId String
  viewedAt DateTime @default(now())

  status WaStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer WaUser   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
  @@index([viewerId])
}
